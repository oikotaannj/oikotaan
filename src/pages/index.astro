---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import Container from "../components/Container.astro";
import EventCard from "../components/EventCard.astro";
import ContactForm from "../components/ContactForm.astro";
import { site } from "../site.config";
import { isUpcoming } from "../lib/dates";

// The filter runs at build time, so the homepage is only as fresh as the last
// deploy. Netlify rebuilds on every merge, which is enough for a site whose
// content changes a few times a month.
const events = await getCollection("events", ({ data }) => !data.draft);

const upcoming = events
  .filter(({ data }) => isUpcoming(data.date, data.endDate))
  .sort((a, b) => a.data.date.getTime() - b.data.date.getTime())
  .slice(0, 3);
---

<BaseLayout title={site.name} description={site.description}>
  <section class="border-b border-sindoor-100 bg-gradient-to-b from-sindoor-50 to-cream">
    <Container class="py-16 sm:py-24">
      <p lang="bn" class="text-lg text-sindoor-700">{site.nameBengali}</p>
      <h1 class="mt-2 max-w-3xl text-4xl leading-tight font-bold text-ink sm:text-5xl">
        {site.tagline}
      </h1>
      <p class="mt-5 max-w-2xl text-lg leading-relaxed text-ink-soft">
        {site.description}
      </p>

      <div class="mt-8 flex flex-wrap gap-3">
        <a
          href="/events/"
          class="rounded-md bg-sindoor-600 px-6 py-3 font-semibold text-white transition-colors hover:bg-sindoor-700"
        >
          See upcoming events
        </a>
        <a
          href={site.zeffy.membershipUrl}
          target="_blank"
          rel="noopener"
          class="rounded-md border border-sindoor-300 bg-white px-6 py-3 font-semibold text-sindoor-700 transition-colors hover:bg-sindoor-50"
        >
          Become a member
        </a>
      </div>
    </Container>
  </section>

  <section class="py-16">
    <Container>
      <div class="flex items-end justify-between gap-4">
        <h2 class="text-2xl font-bold text-ink">Coming up</h2>
        <a href="/events/" class="text-sm font-medium text-sindoor-700 hover:underline">
          All events
        </a>
      </div>

      {
        upcoming.length > 0 ? (
          <div class="mt-6 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
            {upcoming.map((event) => (
              <EventCard event={event} />
            ))}
          </div>
        ) : (
          <p class="mt-6 rounded-xl border border-dashed border-sindoor-200 bg-white p-8 text-ink-soft">
            Nothing on the calendar right now. Check back soon, or write to us below.
          </p>
        )
      }
    </Container>
  </section>

  <section class="pb-16">
    <Container>
      <div
        class="grid gap-10 rounded-2xl border border-sindoor-100 bg-white p-8 sm:p-10 lg:grid-cols-5"
      >
        <div class="lg:col-span-2">
          <h2 class="text-2xl font-bold text-ink">Say hello</h2>
          <p class="mt-3 leading-relaxed text-ink-soft">
            New to the area, curious about Bengali classes for your children, or looking to
            volunteer? Send us a note and one of us will reply. We are all volunteers, so give us a
            few days.
          </p>
          <p class="mt-4 text-sm text-ink-soft">
            Or email <a
              href={`mailto:${site.email}`}
              class="font-medium text-sindoor-700 hover:underline">{site.email}</a
            >
          </p>
        </div>
        <div class="lg:col-span-3">
          <ContactForm />
        </div>
      </div>
    </Container>
  </section>
</BaseLayout>
