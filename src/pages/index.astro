---
import { getCollection, getEntry } from "astro:content";
import StandardHome from "../components/home/StandardHome.astro";
import EventSpotlight from "../components/home/EventSpotlight.astro";
import { isUpcoming } from "../lib/dates";

/**
 * The homepage is one route with two templates behind it.
 *
 *   "standard"  introduces the organisation and lists what is coming up
 *   "spotlight" gives the whole page over to the next event
 *
 * Which one runs is set at /admin under Pages > Home Page, so the committee can
 * switch back after an event without a developer. The spotlight picks the
 * soonest upcoming event on its own, so it advances rather than quietly
 * advertising a puja that already happened; naming an event overrides that.
 *
 * If spotlight is asked for and nothing is upcoming, the standard homepage
 * runs instead. A mode that can leave the site with an empty hero is a mode
 * that will eventually do so, on the morning after the event.
 */
const homeEntry = await getEntry("home", "home");
if (!homeEntry) {
  throw new Error("src/content/home.yaml is missing its top-level `home:` key");
}
const home = homeEntry.data;

const events = await getCollection("events", ({ data }) => !data.draft);
const upcoming = events
  .filter(({ data }) => isUpcoming(data.date, data.endDate))
  .sort((a, b) => a.data.date.getTime() - b.data.date.getTime());

// A named event that has since been deleted or hidden must not blank the
// homepage, so a miss falls through to whatever is next rather than to nothing.
const named = home.layout.eventId ? events.find((e) => e.id === home.layout.eventId) : undefined;

// Falling through silently is how someone picks an event, sees no change on
// the site, and has nothing to go on. The picker no longer offers hidden
// events, but one can still be hidden after it was chosen, so say so in the
// build log rather than only in the absence of an effect.
if (home.layout.eventId && !named) {
  console.warn(
    `[homepage] layout.eventId is "${home.layout.eventId}", but no visible event has that id. ` +
      `It is probably hidden ("Hide from the site") or was deleted. ` +
      `Featuring the next upcoming event instead.`,
  );
}

const spotlit = named ?? upcoming[0];

const useSpotlight = home.layout.mode === "spotlight" && spotlit !== undefined;
---

{
  useSpotlight ? (
    <EventSpotlight event={spotlit!} intro={home.hero.description} contact={home.contact} />
  ) : (
    <StandardHome />
  )
}
