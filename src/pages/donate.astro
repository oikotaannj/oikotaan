---
import BaseLayout from "../layouts/BaseLayout.astro";
import Container from "../components/Container.astro";
import { site } from "../site.config";

/**
 * A holding page for /donate, reached from printed material and old links
 * rather than from the site itself: nothing links here while
 * site.zeffy.donateEnabled is false.
 *
 * It exists because the alternatives were both bad. The path used to redirect
 * to our payment provider's marketing homepage, which took someone who meant
 * to give money and left them on a page that could not take it. Removing the
 * redirect would have given them a 404 instead, which tells them nothing and
 * reads as a dead organisation.
 *
 * When online giving opens, set donateEnabled and point the button here or at
 * the hosted form; this page can then carry the form instead of the apology.
 */
const exemptSince = new Intl.DateTimeFormat("en-US", {
  month: "long",
  year: "numeric",
  timeZone: "UTC",
}).format(new Date(site.taxExempt.effectiveDate));
---

<BaseLayout
  title="Donate"
  description={`Online giving is not open yet. Write to ${site.email} and we will take it from there.`}
>
  <Container class="py-16 sm:py-24">
    <div>
      <h1 class="text-3xl font-bold text-ink sm:text-4xl">Thank you for wanting to give</h1>
      <span class="mt-4 block h-1 w-16 rounded-full bg-marigold-500" aria-hidden="true"></span>

      <p class="mt-6 text-lg leading-relaxed text-ink-soft">
        We are not able to take donations online just yet. We are a young organisation and we are
        still setting that up properly, because money given to {site.name} should arrive somewhere we
        can account for honestly.
      </p>

      <p class="mt-4 text-lg leading-relaxed text-ink-soft">
        In the meantime, please write to us. We will tell you how to give, and we will send you a
        receipt for your records.
      </p>

      <a
        href={`mailto:${site.email}?subject=${encodeURIComponent("I would like to donate to " + site.name)}`}
        class="mt-8 inline-block rounded-md bg-sindoor-600 px-6 py-3 font-semibold text-white transition-colors hover:bg-sindoor-700"
      >
        Email us about giving
      </a>

      <p class="mt-4 text-sm text-ink-soft">
        Or write directly to <a
          href={`mailto:${site.email}`}
          class="font-medium text-sindoor-700 hover:underline">{site.email}</a
        >
      </p>

      <div class="mt-12 rounded-2xl border border-sindoor-100 bg-white p-6 sm:p-8">
        <h2 class="text-lg font-bold text-ink">Your donation is tax deductible</h2>
        <p class="mt-2 leading-relaxed text-ink-soft">
          {site.legalName} is a {site.taxExempt.section} public charity, tax-exempt since {
            exemptSince
          }. Our EIN is {site.ein}. Full details are on our
          <a href="/about/" class="font-medium text-sindoor-700 hover:underline">About page</a>.
        </p>
      </div>

      <div class="mt-10 border-t border-sindoor-100 pt-8">
        <p class="text-ink-soft">
          There are other ways to help that cost nothing. Volunteers run every event we hold, and we
          are always short of hands.
        </p>
        <div class="mt-5 flex flex-wrap gap-3">
          <a
            href="/events/"
            class="rounded-md border border-sindoor-300 bg-white px-5 py-2.5 font-semibold text-sindoor-700 transition-colors hover:bg-sindoor-50"
          >
            See what is coming up
          </a>
          <a
            href="/#contact"
            class="rounded-md border border-sindoor-300 bg-white px-5 py-2.5 font-semibold text-sindoor-700 transition-colors hover:bg-sindoor-50"
          >
            Offer to volunteer
          </a>
        </div>
      </div>
    </div>
  </Container>
</BaseLayout>
