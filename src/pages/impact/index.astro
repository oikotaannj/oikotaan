---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Container from "../../components/Container.astro";
import { formatDateRange, isoDate } from "../../lib/dates";

const entries = await getCollection("impact", ({ data }) => !data.draft);
const sorted = entries.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
const items = await Promise.all(
  sorted.map(async (entry) => ({ entry, Content: (await render(entry)).Content })),
);
---

<BaseLayout
  title="Community Impact"
  description="Food drives, mutual aid and volunteering Oikotaan has done in the community."
>
  <Container class="py-12 sm:py-16">
    <h1 class="text-3xl font-bold text-ink sm:text-4xl">Community Impact</h1>
    <span class="mt-3 block h-1 w-16 rounded-full bg-marigold-500" aria-hidden="true"></span>
    <p class="mt-4 max-w-2xl text-lg leading-relaxed text-ink-soft">
      Beyond pujas and cultural programs, this is what the community has done together —
      food drives, mutual aid and volunteering.
    </p>

    {
      items.length > 0 ? (
        <div class="mt-12 space-y-12">
          {items.map(({ entry, Content }) => {
            const { title, titleBengali, date, endDate, summary, partner, image, imageAlt, gallery } =
              entry.data;
            return (
              <article class="overflow-hidden rounded-2xl border border-sindoor-100 bg-white">
                {image && (
                  <img
                    src={image}
                    alt={imageAlt ?? ""}
                    width="1200"
                    height="630"
                    loading="lazy"
                    decoding="async"
                    class="aspect-[16/9] w-full object-cover"
                  />
                )}
                <div class="p-6 sm:p-8">
                  <time datetime={isoDate(date)} class="text-sm font-semibold text-sindoor-600">
                    {formatDateRange(date, endDate)}
                  </time>
                  <h2 class="mt-1 text-xl font-bold text-ink">{title}</h2>
                  {titleBengali && (
                    <p lang="bn" class="text-sm text-ink-soft">
                      {titleBengali}
                    </p>
                  )}
                  <p class="mt-3 text-ink-soft">{summary}</p>
                  {partner && (
                    <p class="mt-3 text-sm text-ink-soft">
                      In partnership with <span class="font-medium text-ink">{partner}</span>
                    </p>
                  )}
                  <div class="prose prose-sm mt-4 max-w-none text-ink-soft prose-headings:text-ink prose-a:text-sindoor-700">
                    <Content />
                  </div>
                  {gallery && gallery.length > 0 && (
                    <div class="mt-6 grid grid-cols-2 gap-3 sm:grid-cols-4">
                      {gallery.map((photo) => (
                        <img
                          src={photo.image}
                          alt={photo.alt}
                          loading="lazy"
                          decoding="async"
                          class="aspect-square w-full rounded-lg object-cover"
                        />
                      ))}
                    </div>
                  )}
                </div>
              </article>
            );
          })}
        </div>
      ) : (
        <p class="mt-6 rounded-xl border border-dashed border-sindoor-200 bg-white p-8 text-ink-soft">
          Nothing posted here yet.
        </p>
      )
    }
  </Container>
</BaseLayout>
