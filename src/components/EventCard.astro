---
import type { CollectionEntry } from "astro:content";
import { formatDateRange, isoDate } from "../lib/dates";

interface Props {
  event: CollectionEntry<"events">;
}

const { event } = Astro.props;
const { title, titleBengali, date, endDate, time, venue, summary, image, imageAlt } = event.data;
const href = `/events/${event.id}/`;
---

<article
  class="group flex h-full flex-col overflow-hidden rounded-[1.5rem] border border-sindoor-100 bg-paper shadow-card transition-all duration-300 hover:-translate-y-1"
>
  {
    image && (
      <img
        src={image}
        alt={imageAlt ?? ""}
        width="800"
        height="450"
        loading="lazy"
        decoding="async"
        class="aspect-[4/3] w-full object-cover transition-transform duration-500 group-hover:scale-[1.03]"
      />
    )
  }

  <div class="flex flex-1 flex-col p-6">
    <time datetime={isoDate(date)} class="eyebrow">
      {formatDateRange(date, endDate)}
    </time>

    <h3 class="display-heading mt-2 text-2xl text-ink">
      <!-- The whole card is clickable via this stretched link, which keeps one
           real anchor in the accessibility tree instead of wrapping the card in
           an <a> that swallows the heading. -->
      <a
        href={href}
        class="after:absolute after:inset-0 transition-colors group-hover:text-sindoor-700"
      >
        {title}
      </a>
    </h3>
    {
      titleBengali && (
        <p lang="bn" class="text-sm text-ink-soft">
          {titleBengali}
        </p>
      )
    }

    <p class="mt-4 flex-1 text-sm leading-relaxed text-ink-soft">{summary}</p>

    <p class="mt-5 border-t border-sindoor-100 pt-4 text-sm text-ink-soft">
      <span class="font-medium text-ink">{venue}</span>
      {time && <span class="block">{time}</span>}
    </p>
  </div>
</article>

<style>
  article {
    position: relative;
  }
</style>
