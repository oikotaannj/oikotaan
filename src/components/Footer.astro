---
import { site, nav } from "../site.config";
import Container from "./Container.astro";

const year = new Date().getFullYear();
const socials = Object.entries(site.social).filter(([, url]) => url);
---

<footer class="mt-20 border-t border-sindoor-100 bg-white">
  <Container class="grid gap-8 py-12 sm:grid-cols-3">
    <div>
      <p class="font-semibold text-ink">{site.name}</p>
      <p lang="bn" class="text-sm text-ink-soft">{site.nameBengali}</p>
      <p class="mt-3 text-sm text-ink-soft">{site.town}</p>
      <p class="mt-1 text-sm text-ink-soft">
        A registered 501(c)(3) nonprofit. Donations are tax deductible.
      </p>
    </div>

    <div>
      <p class="text-sm font-semibold tracking-wide text-ink uppercase">Pages</p>
      <ul class="mt-3 space-y-2 text-sm">
        {
          nav.map((item) => (
            <li>
              <a href={item.href} class="text-ink-soft hover:text-sindoor-700">
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <div>
      <p class="text-sm font-semibold tracking-wide text-ink uppercase">Get in touch</p>
      <ul class="mt-3 space-y-2 text-sm">
        <li>
          <a href={`mailto:${site.email}`} class="text-ink-soft hover:text-sindoor-700">
            {site.email}
          </a>
        </li>
        {
          socials.map(([name, url]) => (
            <li>
              <a
                href={url}
                target="_blank"
                rel="noopener"
                class="capitalize text-ink-soft hover:text-sindoor-700"
              >
                {name}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </Container>

  <Container class="border-t border-sindoor-100 py-6">
    <p class="text-xs text-ink-soft">
      &copy; {year}
      {site.name}. Photographs of children are published with the consent of a parent or guardian.
      To request a removal, email
      <a href={`mailto:${site.email}`} class="underline hover:text-sindoor-700">{site.email}</a>.
    </p>
  </Container>
</footer>
