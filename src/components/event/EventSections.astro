---
import type { CollectionEntry } from "astro:content";
import Container from "../Container.astro";
import SectionShell from "./SectionShell.astro";
import HighlightsSection from "./HighlightsSection.astro";
import ScheduleSection from "./ScheduleSection.astro";
import ProgramsSection from "./ProgramsSection.astro";
import FoodSection from "./FoodSection.astro";
import RegistrationSection from "./RegistrationSection.astro";
import PaymentSection from "./PaymentSection.astro";

interface Props {
  sections: CollectionEntry<"events">["data"]["sections"];
}

const { sections } = Astro.props;
---

{
  sections.map((section) => {
    if (section.type === "highlights") return <HighlightsSection data={section} />;
    if (section.type === "schedule") return <ScheduleSection data={section} />;
    if (section.type === "programs") return <ProgramsSection data={section} />;
    if (section.type === "menu") return <FoodSection data={section} />;
    if (section.type === "registration") return <RegistrationSection data={section} />;
    if (section.type === "payment") return <PaymentSection data={section} />;

    if (section.type === "story") {
      return (
        <section class="border-t border-sindoor-100 bg-white py-16 sm:py-20">
          <Container class="grid items-center gap-10 lg:grid-cols-2 lg:gap-16">
            <div class:list={[!section.image && "lg:col-span-2 lg:max-w-3xl"]}>
              <p class="eyebrow">Our story</p>
              <h2 class="display-heading mt-3 text-3xl text-ink sm:text-4xl">{section.heading}</h2>
              <p class="mt-5 whitespace-pre-line text-lg leading-relaxed text-ink-soft">
                {section.body}
              </p>
            </div>
            {section.image && (
              <img
                src={section.image}
                alt={section.imageAlt ?? ""}
                loading="lazy"
                decoding="async"
                class="aspect-[4/3] w-full rounded-[2rem] object-cover shadow-card"
              />
            )}
          </Container>
        </section>
      );
    }

    if (section.type === "gallery" && section.photos.length > 0) {
      return (
        <SectionShell heading={section.heading} intro={section.intro} tone="white">
          <div class="grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-4">
            {section.photos.map((photo, index) => (
              <img
                src={photo.image}
                alt={photo.alt}
                loading="lazy"
                decoding="async"
                class:list={[
                  "w-full rounded-2xl object-cover",
                  index % 5 === 0 ? "col-span-2 aspect-[2/1]" : "aspect-square",
                ]}
              />
            ))}
          </div>
        </SectionShell>
      );
    }

    if (section.type === "faq" && section.items.length > 0) {
      return (
        <SectionShell heading={section.heading}>
          <div class="max-w-3xl divide-y divide-sindoor-100 rounded-2xl border border-sindoor-100 bg-white px-6 sm:px-8">
            {section.items.map((item) => (
              <details class="group py-5">
                <summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-semibold text-ink">
                  {item.question}
                  <span
                    class="text-xl text-sindoor-600 transition-transform group-open:rotate-45"
                    aria-hidden="true"
                  >
                    +
                  </span>
                </summary>
                <p class="mt-3 leading-relaxed text-ink-soft">{item.answer}</p>
              </details>
            ))}
          </div>
        </SectionShell>
      );
    }

    return null;
  })
}
