---
import Container from "../Container.astro";

/**
 * The frame every event-page section sits in: heading, marigold rule, optional
 * intro. Having it in one place is what stops six sections drifting into six
 * slightly different headings.
 */
interface Props {
  id?: string;
  heading: string;
  intro?: string;
  tone?: "cream" | "white";
}
const { id, heading, intro, tone = "cream" } = Astro.props;
---

<section
  id={id}
  class:list={[
    "scroll-mt-24 border-t border-sindoor-100 py-16 sm:py-20",
    tone === "white" ? "bg-paper" : "",
  ]}
>
  <Container>
    <h2 class="display-heading text-3xl text-ink sm:text-4xl">{heading}</h2>
    {intro && <p class="mt-4 text-lg leading-relaxed text-ink-soft">{intro}</p>}
    <div class="mt-8">
      <slot />
    </div>
  </Container>
</section>
