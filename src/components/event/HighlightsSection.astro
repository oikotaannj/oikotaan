---
import SectionShell from "./SectionShell.astro";

interface Props {
  data: NonNullable<
    NonNullable<
      import("astro:content").CollectionEntry<"events">["data"]["spotlight"]
    >["highlights"]
  >;
}
const { data } = Astro.props;
---

{
  data.items.length > 0 && (
    <SectionShell id="highlights" heading={data.heading} intro={data.intro} tone="white">
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {data.items.map((item, i) => (
          <article class="flex flex-col overflow-hidden rounded-2xl border border-sindoor-100 bg-cream">
            {item.image && (
              <img
                src={item.image}
                alt={item.imageAlt ?? ""}
                width="800"
                height="450"
                loading="lazy"
                decoding="async"
                class="aspect-[16/9] w-full object-cover"
              />
            )}
            <div class="flex flex-1 flex-col p-6">
              {/* The number is decoration, not content: a screen reader
                  announcing "zero one" before every heading is noise. */}
              <span class="font-serif text-2xl text-marigold-600" aria-hidden="true">
                {String(i + 1).padStart(2, "0")}
              </span>
              {item.kicker && (
                <p class="mt-2 text-xs font-semibold tracking-wide text-sindoor-600 uppercase">
                  {item.kicker}
                </p>
              )}
              <h3 class="mt-1 text-lg font-semibold text-ink">{item.title}</h3>
              {item.description && (
                <p class="mt-2 text-sm leading-relaxed text-ink-soft">{item.description}</p>
              )}
            </div>
          </article>
        ))}
      </div>
    </SectionShell>
  )
}
