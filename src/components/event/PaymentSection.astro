---
import SectionShell from "./SectionShell.astro";

interface Props {
  data: Extract<
    import("astro:content").CollectionEntry<"events">["data"]["sections"][number],
    { type: "payment" }
  >;
}
const { data } = Astro.props;
---

{
  (data.qrImage || data.methods.length > 0) && (
    <SectionShell id="payment" heading={data.heading} intro={data.intro}>
      <div class="grid gap-8 lg:grid-cols-5">
        {data.qrImage && (
          <div class="lg:col-span-2">
            <div class="rounded-2xl border border-sindoor-100 bg-white p-6 text-center">
              {/* A QR code is unreadable to anyone using a screen reader, and
                  unusable to anyone reading this on the device that would have
                  to scan it. The methods list beside it carries the same
                  details as text, which is why it is not optional in practice. */}
              <img
                src={data.qrImage}
                alt={data.qrAlt ?? "Payment QR code"}
                width="320"
                height="320"
                class="mx-auto aspect-square w-full max-w-[260px] rounded-lg object-contain"
              />
              {data.qrCaption && <p class="mt-3 text-sm text-ink-soft">{data.qrCaption}</p>}
            </div>
          </div>
        )}

        {data.methods.length > 0 && (
          <div class:list={[data.qrImage ? "lg:col-span-3" : "lg:col-span-5"]}>
            <dl class="divide-y divide-sindoor-100 overflow-hidden rounded-2xl border border-sindoor-100 bg-white">
              {data.methods.map((m) => (
                <div class="grid gap-1 p-5 sm:grid-cols-3 sm:gap-4">
                  <dt class="text-sm font-semibold tracking-wide text-ink-soft uppercase">
                    {m.label}
                  </dt>
                  <dd class="sm:col-span-2">
                    {/* select-all so someone can copy a handle in one gesture
                        on a phone rather than fighting a text selection. */}
                    <span class="font-medium break-words text-ink select-all">{m.value}</span>
                    {m.note && <span class="mt-1 block text-sm text-ink-soft">{m.note}</span>}
                  </dd>
                </div>
              ))}
            </dl>
          </div>
        )}
      </div>

      {data.note && <p class="mt-6 text-sm leading-relaxed text-ink-soft">{data.note}</p>}
    </SectionShell>
  )
}
