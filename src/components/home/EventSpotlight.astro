---
import type { CollectionEntry } from "astro:content";
import { render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Container from "../Container.astro";
import ContactSection from "./ContactSection.astro";
import { site } from "../../site.config";
import { formatDateRange, isoDate } from "../../lib/dates";

/**
 * A homepage given over to a single event, for the weeks when one thing is the
 * reason anybody is visiting. The standard homepage introduces the
 * organisation and lists what is coming up; this one answers "when, where, and
 * what is it" above the fold and leaves the introduction until after.
 *
 * It is rendered instead of StandardHome when site.homeLayout is "spotlight",
 * and index.astro falls back to the standard page when there is no upcoming
 * event to spotlight, so the mode cannot leave the site with an empty hero.
 */
interface Props {
  event: CollectionEntry<"events">;
  intro: string;
  contact: { heading: string; body: string };
}

const { event, intro, contact } = Astro.props;
const {
  title,
  titleBengali,
  date,
  endDate,
  time,
  venue,
  address,
  summary,
  image,
  imageAlt,
  ticketUrl,
} = event.data;
const { Content } = await render(event);

const mapUrl = address
  ? `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(address)}`
  : null;
const detailsUrl = `/events/${event.id}/`;
---

<BaseLayout title={title} description={summary} image={image}>
  <section class="border-b border-sindoor-100 bg-gradient-to-b from-sindoor-50 to-cream">
    <Container class="grid items-center gap-10 py-14 sm:py-20 lg:grid-cols-2">
      <div>
        <p lang="bn" class="text-lg text-sindoor-700">{site.nameBengali}</p>

        <h1 class="mt-3 text-4xl leading-tight font-bold text-ink sm:text-5xl">{title}</h1>
        {
          titleBengali && (
            <p lang="bn" class="mt-2 text-2xl text-sindoor-700">
              {titleBengali}
            </p>
          )
        }

        <span class="mt-5 block h-1 w-16 rounded-full bg-marigold-500" aria-hidden="true"></span>

        <p class="mt-5 max-w-xl text-lg leading-relaxed text-ink-soft">{summary}</p>

        <!-- When and where sit in the hero rather than further down. For the
             weeks this layout is up, they are the two things a visitor came
             for, and making them scroll for the address is the whole failure
             this page exists to avoid. -->
        <dl class="mt-8 grid gap-5 sm:grid-cols-2">
          <div>
            <dt class="text-xs font-semibold tracking-wide text-ink-soft uppercase">When</dt>
            <dd class="mt-1 text-lg font-medium text-ink">
              <time datetime={isoDate(date)}>{formatDateRange(date, endDate)}</time>
              {time && <span class="block text-base font-normal text-ink-soft">{time}</span>}
            </dd>
          </div>
          <div>
            <dt class="text-xs font-semibold tracking-wide text-ink-soft uppercase">Where</dt>
            <dd class="mt-1 text-lg font-medium text-ink">
              {venue}
              {
                address && (
                  <a
                    href={mapUrl}
                    target="_blank"
                    rel="noopener"
                    class="block text-base font-normal text-ink-soft hover:text-sindoor-700 hover:underline"
                  >
                    {address}
                  </a>
                )
              }
            </dd>
          </div>
        </dl>

        <div class="mt-8 flex flex-wrap gap-3">
          {
            ticketUrl && (
              <a
                href={ticketUrl}
                target="_blank"
                rel="noopener"
                class="rounded-md bg-sindoor-600 px-6 py-3 font-semibold text-white transition-colors hover:bg-sindoor-700"
              >
                Register or buy tickets
              </a>
            )
          }
          <a
            href={detailsUrl}
            class:list={[
              "rounded-md px-6 py-3 font-semibold transition-colors",
              ticketUrl
                ? "border border-sindoor-300 bg-white text-sindoor-700 hover:bg-sindoor-50"
                : "bg-sindoor-600 text-white hover:bg-sindoor-700",
            ]}
          >
            Full event details
          </a>
          <a
            href="/events/"
            class="rounded-md border border-sindoor-300 bg-white px-6 py-3 font-semibold text-sindoor-700 transition-colors hover:bg-sindoor-50"
          >
            All events
          </a>
        </div>
      </div>

      {
        image && (
          <div class="relative mx-auto w-full max-w-md lg:max-w-none">
            <div
              class="absolute -top-4 -right-4 h-full w-full rounded-2xl bg-marigold-300/60 sm:-top-6 sm:-right-6"
              aria-hidden="true"
            />
            <img
              src={image}
              alt={imageAlt ?? ""}
              width="1600"
              height="900"
              class="relative w-full rounded-2xl object-cover shadow-xl"
            />
          </div>
        )
      }
    </Container>
  </section>

  <section class="py-14">
    <Container>
      <div class="prose prose-lg max-w-2xl prose-headings:text-ink prose-a:text-sindoor-700">
        <Content />
      </div>
    </Container>
  </section>

  <!-- Someone who arrived for the puja may never have heard of us, so the
       introduction the standard homepage leads with goes here instead of
       being dropped. -->
  <section class="border-y border-sindoor-100 bg-white py-14">
    <Container>
      <div class="max-w-2xl">
        <h2 class="text-2xl font-bold text-ink">About {site.name}</h2>
        <span class="mt-2 block h-1 w-12 rounded-full bg-marigold-500" aria-hidden="true"></span>
        <p class="mt-4 text-lg leading-relaxed text-ink-soft">{intro}</p>
        <div class="mt-6 flex flex-wrap gap-3">
          <a
            href="/about/"
            class="rounded-md border border-sindoor-300 bg-white px-5 py-2.5 font-semibold text-sindoor-700 transition-colors hover:bg-sindoor-50"
          >
            Who we are
          </a>
          <a
            href="/impact/"
            class="rounded-md border border-sindoor-300 bg-white px-5 py-2.5 font-semibold text-sindoor-700 transition-colors hover:bg-sindoor-50"
          >
            Community impact
          </a>
        </div>
      </div>
    </Container>
  </section>

  <div class="pt-14">
    <ContactSection heading={contact.heading} body={contact.body} />
  </div>
</BaseLayout>
