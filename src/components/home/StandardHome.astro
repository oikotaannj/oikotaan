---
import { getCollection, getEntry } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Container from "../Container.astro";
import EventCard from "../EventCard.astro";
import ContactSection from "./ContactSection.astro";
import { site } from "../../site.config";
import { formatDateRange, isUpcoming } from "../../lib/dates";

const homeEntry = await getEntry("home", "home");
if (!homeEntry) throw new Error("src/content/home.yaml is missing");
const home = homeEntry.data;

const programIcons: Record<string, string> = {
  flame: `<path d="M12 2c1.5 2.5 2 4 2 5.5a2 2 0 1 1-4 0C10 5.5 10.5 4.5 12 2Z"/><path d="M5 14c0-3.5 3-5 7-5s7 1.5 7 5c0 4-3 7-7 7s-7-3-7-7Z"/>`,
  book: `<path d="M4 5.5C4 4.67 4.67 4 5.5 4H12v16H5.5A1.5 1.5 0 0 1 4 18.5v-13Z"/><path d="M20 5.5c0-.83-.67-1.5-1.5-1.5H12v16h6.5c.83 0 1.5-.67 1.5-1.5v-13Z"/>`,
  heart: `<path d="M12 20s-7-4.35-9.5-8.8C1 8.3 2.4 5 5.6 5c1.9 0 3.3 1 4.4 2.6C11.1 6 12.5 5 14.4 5 17.6 5 19 8.3 17.5 11.2 15 15.65 12 20 12 20Z"/>`,
};

const events = await getCollection("events", ({ data }) => !data.draft);
const upcoming = events
  .filter(({ data }) => isUpcoming(data.date, data.endDate))
  .sort((a, b) => a.data.date.getTime() - b.data.date.getTime());
const featured = upcoming.find(({ data }) => data.featured);
const cards = upcoming.filter((event) => event.id !== featured?.id).slice(0, 3);
---

<BaseLayout title={site.name} description={site.description}>
  <section class="alpona-wash overflow-hidden border-b border-sindoor-100 bg-cream">
    <Container
      class="grid min-h-[680px] items-center gap-12 py-16 lg:grid-cols-[1.05fr_.95fr] lg:gap-20 lg:py-24"
    >
      <div class="relative z-10">
        <p class="eyebrow">Bengali culture · New Jersey</p>
        <p lang="bn" class="mt-3 text-xl text-sindoor-700">{home.hero.kicker}</p>
        <h1 class="display-heading mt-3 max-w-3xl text-5xl text-ink sm:text-6xl lg:text-7xl">
          {home.hero.heading}
        </h1>
        <p class="mt-7 max-w-xl text-lg leading-relaxed text-ink-soft">{home.hero.description}</p>
        <div class="mt-9 flex flex-wrap gap-3">
          <a
            href="/events/"
            class="rounded-full bg-sindoor-600 px-6 py-3.5 font-semibold text-white shadow-sm transition-all hover:-translate-y-0.5 hover:bg-sindoor-700"
            >Explore upcoming events</a
          >
          <a
            href="/about/"
            class="rounded-full border border-sindoor-200 bg-paper px-6 py-3.5 font-semibold text-sindoor-700 transition-colors hover:bg-sindoor-50"
            >Discover our story</a
          >
        </div>
      </div>

      <div class="relative mx-auto w-full max-w-lg pb-10 lg:pb-0">
        <div
          class="absolute -top-6 -right-6 h-48 w-48 rounded-full border border-marigold-400/50"
          aria-hidden="true"
        >
        </div>
        <div
          class="absolute -top-10 -right-10 h-56 w-56 rounded-full border border-sindoor-300/40"
          aria-hidden="true"
        >
        </div>
        <img
          src={home.hero.image}
          alt={home.hero.imageAlt}
          width="825"
          height="1100"
          class="relative aspect-[4/5] w-full rounded-[2.5rem] object-cover shadow-card"
        />
        {
          featured && (
            <a
              href={`/events/${featured.id}/`}
              class="absolute -bottom-2 left-4 right-4 rounded-2xl border border-white/60 bg-paper/95 p-5 shadow-card backdrop-blur sm:left-[-2rem] sm:right-auto sm:w-[22rem]"
            >
              <p class="eyebrow">
                Next gathering · {formatDateRange(featured.data.date, featured.data.endDate)}
              </p>
              <h2 class="display-heading mt-2 text-2xl text-ink">{featured.data.title}</h2>
              <p class="mt-1 text-sm text-ink-soft">{featured.data.venue}</p>
              <span class="mt-3 inline-block text-sm font-bold text-sindoor-700">View event →</span>
            </a>
          )
        }
      </div>
    </Container>
  </section>

  <section class="bg-paper py-16 sm:py-20">
    <Container>
      <div class="max-w-2xl">
        <p class="eyebrow">What brings us together</p><h2
          class="display-heading mt-3 text-4xl text-ink sm:text-5xl"
        >
          Culture is something we practice together.
        </h2>
      </div>
      <div
        class="mt-12 grid gap-px overflow-hidden rounded-[2rem] border border-sindoor-100 bg-sindoor-100 sm:grid-cols-3"
      >
        {
          home.programs.map((program, index) => (
            <article class="bg-paper p-7 sm:p-8">
              <div class="flex items-start justify-between gap-4">
                <span class="inline-flex h-12 w-12 items-center justify-center rounded-full bg-sindoor-50 text-sindoor-600">
                  <svg
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    class="h-6 w-6"
                    set:html={programIcons[program.icon]}
                  />
                </span>
                <span class="font-serif text-3xl text-marigold-500/70" aria-hidden="true">
                  0{index + 1}
                </span>
              </div>
              <h3 class="display-heading mt-8 text-2xl text-ink">{program.title}</h3>
              <p class="mt-3 text-sm leading-relaxed text-ink-soft">{program.description}</p>
            </article>
          ))
        }
      </div>
    </Container>
  </section>

  <section class="py-16 sm:py-20">
    <Container>
      <div class="flex items-end justify-between gap-4">
        <div>
          <p class="eyebrow">Gather with us</p><h2
            class="display-heading mt-3 text-4xl text-ink sm:text-5xl"
          >
            Coming up
          </h2>
        </div><a
          href="/events/"
          class="hidden font-semibold text-sindoor-700 hover:underline sm:block"
          >See all events →</a>
      </div>
      {
        cards.length > 0 ? (
          <div class="mt-9 grid gap-7 sm:grid-cols-2 lg:grid-cols-3">
            {cards.map((event) => (
              <EventCard event={event} />
            ))}
          </div>
        ) : featured ? (
          <p class="mt-8 text-ink-soft">More gatherings will be announced soon.</p>
        ) : (
          <p class="mt-8 rounded-2xl border border-dashed border-sindoor-200 bg-paper p-8 text-ink-soft">
            Nothing on the calendar right now. Check back soon, or write to us below.
          </p>
        )
      }
    </Container>
  </section>

  {
    home.gallery.length > 0 && (
      <section class="bg-leaf py-16 text-paper sm:py-20">
        <Container>
          <p class="text-xs font-extrabold tracking-[.14em] text-marigold-300 uppercase">
            From our community
          </p>
          <div class="mt-3 flex items-end justify-between gap-6">
            <>
              <h2 class="display-heading text-4xl sm:text-5xl">Moments worth sharing.</h2>
              <p class="hidden max-w-md text-sm leading-relaxed text-cream/70 md:block">
                Pujas, performances, volunteering and the small moments between them.
              </p>
            </>
          </div>
          <div class="mt-10 grid grid-cols-2 gap-3 sm:grid-cols-4">
            {home.gallery.slice(0, 5).map((photo, index) => (
              <img
                src={photo.image}
                alt={photo.alt}
                loading="lazy"
                decoding="async"
                class:list={[
                  "w-full rounded-2xl object-cover",
                  index === 0 ? "col-span-2 row-span-2 aspect-square" : "aspect-square",
                ]}
              />
            ))}
          </div>
        </Container>
      </section>
    )
  }

  <div class="pt-16">
    <ContactSection heading={home.contact.heading} body={home.contact.body} />
  </div>
</BaseLayout>
