# Netlify reads this file verbatim. Security headers cost nothing on a static
# site and stop the page being framed by someone else's domain.
/*
  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=()

# Astro fingerprints these filenames, so a new build produces a new name and an
# aggressive cache can never serve a stale one.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable
